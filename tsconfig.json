{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "types": [
      "node",
      "vite/client",
      "@testing-library/jest-dom/vitest"
    ],
    "paths": {
      "@/*": [
        "./playground/*"
      ]
    }
  },
  "include": [
    "exercises",
    "playground",
    "test",
    "vite.config.ts"
  ]
}
